Dataset({
    features: ['references', 'testcase', 'name', 'feature', 'item'],
    num_rows: 127
})
IDX = 0



{'Test Purpose': 'Verify that the button release is sent following a button press when the CT issues a PASS THROUGH\ncommand.', 'Initial Condition': '- One ACL connection exists between the IUT and the Lower Tester.\n   - The AVCTP connection between the IUT and the Lower Tester is completed.\n   - The IUT is acting as AVRCP CT.', 'Test Procedure': 'The Upper Tester triggers the IUT to issue commands for button press and release.', 'Expected Outcome': 'Pass verdict\nThe IUT issues a correctly formatted PASS THROUGH command with the state flag set to button\npress, followed within 2 seconds by a correctly formatted PASS THROUGH command with the same\noperation id with the state flag set to button release.'}



IDX = 1



{'Test Purpose': 'Verify that when a button to send a PASS THROUGH command is held down the CT continues to\nissue button presses every 2 seconds until the button is released.', 'Initial Condition': '- One ACL connection exists between the IUT and the Lower Tester.\n   - The AVCTP connection between the IUT and the Lower Tester is completed.\n   - The IUT is acting as AVRCP CT.', 'Test Procedure': 'The Upper Tester triggers the IUT to issue commands for button press and release. The button is\nheld for longer than 2 seconds.', 'Expected Outcome': 'Pass verdict\nThe IUT issues a correctly formatted PASS THROUGH command with the state flag set to button\npress.\nAnother PASS THROUGH command with the same operation id and state flag set to button press is\nissued within 2 seconds of each previous PASS THROUGH command until the button is released.\nAt least two PASS THROUGH commands are sent with the state flag set to button press.\nA final PASS THROUGH command with the same operation id and state flag set to button release is\nsent within 2 seconds of the last button press.'}



