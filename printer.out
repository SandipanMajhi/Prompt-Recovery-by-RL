IDX = 66



{'Test Purpose': 'Verify the Track Changed INTERIM response when the track is SELECTED.', 'Initial Condition': '- The IUT is active as AVRCP TG role.\n   - A track is currently SELECTED on the IUT.', 'Test Procedure': 'The Lower Tester issues a valid RegisterNotification for the EVENT_TRACK_CHANGED.', 'Expected Outcome': 'Pass verdict\nThe IUT issues a correctly formatted RegisterNotification Interim Response for the\nEVENT_TRACK_CHANGED.\nThe Identifier Parameter is set to a value other than 0xFFFFFFFF for an IUT that supports\nAVRCP v1.3.\nThe Identifier Parameter is set to 0x0 for an IUT that supports AVRCP v1.4 or later.'}



